<configuration>
	<statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<filter class="ch.qos.logback.classic.filter.LevelFilter">
			<level>INFO</level>
			<onMatch>ACCEPT</onMatch>
			<onMismatch>DENY</onMismatch>
		</filter>
		<encoder>
			<pattern>%msg%n</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>hermod-gippity.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<!-- File name pattern -->
			<fileNamePattern>logs/%d{yyyyMM}/hermod-gippity_%d{yyyyMMdd_HHmmss_SSS}.log.zip</fileNamePattern>
			<maxFileSize>25MB</maxFileSize>
		</rollingPolicy>
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<logger name="it.patcha.hermod.gpt" level="INFO" additivity="false">
		<appender-ref ref="CONSOLE" />
	</logger>

	<logger name="it.patcha.hermod.gpt" level="DEBUG" additivity="false">
		<appender-ref ref="FILE" />
	</logger>

	<logger name="ch.qos.logback" level="ERROR" additivity="false">
		<appender-ref ref="FILE" />
	</logger>

	<logger name="org.springframework" level="WARN" additivity="false">
		<appender-ref ref="FILE" />
	</logger>

	<logger name="org.apache.activemq" level="WARN" additivity="false">
		<appender-ref ref="FILE" />
	</logger>

	<root level="ERROR">
		<appender-ref ref="FILE" />
	</root>

</configuration>
